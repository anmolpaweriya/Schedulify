# Server Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/appointment-scheduler

# Auth Config
JWT_SECRET=your_jwt_super_secret_key_change_me_in_production
JWT_EXPIRE=30d

# SMTP Email Configuration (Optional - fallback to console logger if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@appointmentscheduler.com
